BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
TabWidth: 4
UseTab: Always
BreakBeforeBraces: Attach
AllowShortIfStatementsOnASingleLine: false
ColumnLimit: 120
PointerAlignment: Left
SortIncludes: false
# Small diffs (plan dev-friction-review): one longer line must not re-indent its neighbours' comments or line
# continuations. Consecutive assignments, declarations and macros are not aligned already (LLVM).
AlignTrailingComments:
  Kind: Never
AlignEscapedNewlines: DontAlign
# Wrapped calls (AGENTS.md, code style): one argument per line, the closing parenthesis on its own line. A call that
# fits on one line stays on one line. The assignment penalty keeps `x = f(` on the first line instead of breaking
# after the `=` into the old aligned layout.
AlignAfterOpenBracket: BlockIndent
BinPackArguments: false
BinPackParameters: OnePerLine
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
PenaltyBreakAssignment: 200
