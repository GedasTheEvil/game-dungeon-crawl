#! /bin/sh
# Install-check (plan install-helper-script): finds the shared libs bin/game lacks and prints one `apt install` line.
# Never installs anything. Ubuntu / Linux Mint (apt, amd64); other systems get the soname list only.
# Also checks the glibc version (the release's floor) and that an OpenGL driver is installed (SDL loads it at run time).
# Exit 0: nothing missing, 1: something missing (or too old / unsupported system), 2: no bin/game.
# Test hooks: IC_OS_RELEASE (default /etc/os-release); `ldd`, `getconf` and `ldconfig` come from PATH.
cd "$(dirname "$0")" || exit 2
[ -e bin/game ] || { echo "Install-check: bin/game not found (run from the unzipped release)"; exit 2; }

# The oldest glibc this release runs on (tools/release.sh writes it in the zip's copy; plan portable-linux-release).
glibc_floor=2.31

# glibc first: with an older one the loader refuses bin/game before any library counts.
glibc=$(getconf GNU_LIBC_VERSION 2>/dev/null | sed -n 's/^glibc //p')
if [ -n "$glibc" ] && [ "$(printf '%s\n%s\n' "$glibc_floor" "$glibc" | sort -V | head -1)" != "$glibc_floor" ]; then
	echo "Too old system: glibc $glibc, the game needs $glibc_floor or newer (Ubuntu 20.04, Linux Mint 20, Debian 11 or newer)."
	exit 1
fi
[ -n "$glibc" ] || echo "Hint: glibc version unknown (no getconf); the game needs $glibc_floor or newer."

# soname -> apt package. The portable release needs only glibc and its own lib/libSDL3.so.0; the rest is for a
# release built on the dev PC (tools/release.sh --host), which links the system's SDL3, FreeType and libstdc++.
pkg_for() {
	case "$1" in
		libSDL3.so*) echo libsdl3-0 ;;
		libfreetype.so*) echo libfreetype6 ;;
		libGL.so*) echo "libgl1 libgl1-mesa-dri" ;;
		libstdc++.so*) echo libstdc++6 ;;
		libgcc_s.so*) echo libgcc-s1 ;;
		libc.so* | libm.so* | libmvec.so*) echo libc6 ;;
		*) echo "" ;;
	esac
}

# the ldd result decides, not dpkg
missing=$(ldd bin/game 2>&1 | sed -n 's/^[[:space:]]*\([^ ]*\) => not found.*/\1/p' | sort -u)
if [ -d lib ] && [ ! -e lib/libSDL3.so.0 ]; then
	echo "lib/libSDL3.so.0 is missing: unzip the release again."
	exit 1
fi
# SDL opens the GL driver itself (bin/game does not link it, so ldd cannot see it): GLX or EGL, the vendor's or Mesa's.
ldconfig_cmd=$(command -v ldconfig || echo /sbin/ldconfig)
if [ -x "$ldconfig_cmd" ] && ! "$ldconfig_cmd" -p 2>/dev/null | grep -qE 'lib(GL|EGL)\.so\.1 '; then
	missing=$(printf '%s\n' $missing libGL.so.1 | sort -u)
fi

packages=""
unknown=""
for so in $missing; do
	p=$(pkg_for "$so")
	if [ -n "$p" ]; then
		case " $packages " in *" $p "*) ;; *) packages="$packages $p" ;; esac
	else
		unknown="$unknown $so"
	fi
done

if [ -z "$missing" ]; then
	echo "Libraries: all found."
else
	echo "Missing libraries:$(printf ' %s' $missing)"
fi

apt_system=0
os_release=${IC_OS_RELEASE:-/etc/os-release}
if [ -r "$os_release" ]; then
	id=$(sed -n 's/^ID=//p' "$os_release" | tr -d '"')
	like=$(sed -n 's/^ID_LIKE=//p' "$os_release" | tr -d '"')
	case " $id $like " in *" ubuntu "* | *" debian "* | *" linuxmint "*) apt_system=1 ;; esac
fi

# runtime needs ldd cannot see: hints only, they never change the exit code
if command -v glxinfo >/dev/null 2>&1; then
	glxinfo 2>/dev/null | grep -q 'OpenGL core profile version string: [3-9]\.' ||
		echo "Hint: no OpenGL 3.3 core driver reported by glxinfo (the game needs one; try: sudo apt install libgl1 libgl1-mesa-dri)."
fi
if [ -z "$(ls /proc/asound 2>/dev/null)" ] && ! command -v pactl >/dev/null 2>&1; then
	echo "Hint: no audio device found; the game runs without sound."
fi

if [ -z "$missing" ]; then
	echo "All good, run ./Play"
	exit 0
fi

if [ "$apt_system" = 1 ]; then
	[ -n "$unknown" ] && echo "No package known for:$unknown (search it with: apt-file search <soname>)"
	[ -n "$packages" ] && echo "Run:  sudo apt install$packages"
	echo "Then run ./Install-check again (libraries hidden behind a missing one show up only then)."
else
	echo "Unsupported system (no apt: Ubuntu / Linux Mint only), libs needed:$(printf ' %s' $missing)"
fi
exit 1
