Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-optin.portability.UnixAPI,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  portability-*,
  readability-avoid-const-params-in-decls,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-duplicate-include,
  readability-implicit-bool-conversion,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-control-flow,
  readability-redundant-member-init,
  readability-redundant-smartptr-get,
  readability-redundant-string-cstr,
  readability-identifier-naming,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,
  readability-uniqueptr-delete-release,
  modernize-use-nullptr,
  modernize-use-bool-literals,
  modernize-use-override
WarningsAsErrors: ''
# optin.portability.UnixAPI is off: it flags malloc(0) paths inside external/stb it cannot rule out (the scenario
# screenshot sizes are checked before stbi_write_png).
# Paths are absolute. Only the project's own headers: the last directory must be one of ours, which leaves out
# external/stb (reached as src/graphics/../../external/stb/...). clang-tidy 18 has no ExcludeHeaderFilterRegex.
HeaderFilterRegex: '.*/(src/(.*/)?(core|entities|graphics|input|state|test|ui|world)|tools/editor)/[a-z_]+\.h$'
FormatStyle: file
# Naming: only what the code base follows throughout. Method and function names are mixed (older PascalCase next
# to newer camelBack) and are not checked.
CheckOptions:
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.LocalConstantCase
    value: camelBack
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: '1'
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: '1'
